# --- DataMETL app metadata DB (Postgres run by docker-compose) ---
APP_DB_USER=datametl
APP_DB_PASSWORD=datametl
APP_DB_NAME=datametl
APP_DB_HOST=app-postgres
APP_DB_PORT=5432

# Backend reads this composed URL
DATABASE_URL=postgresql+psycopg://datametl:datametl@app-postgres:5432/datametl

# --- Redis (arq queue) ---
REDIS_URL=redis://redis:6379/0

# --- Credential vault ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=CHANGE_ME_GENERATE_A_FERNET_KEY

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3005

# --- Simple in-app login (optional) ---
# Off by default. When true, the app requires a single shared username/password.
# Leave false when running behind oauth2-proxy/Keycloak (the k8s edge auth) to avoid a double login.
# AUTH_PASSWORD only seeds the credential on first run; after that change it in Settings.
AUTH_ENABLED=false
AUTH_USERNAME=admin
AUTH_PASSWORD=

# --- Prometheus metrics (/metrics) ---
# Exposed outside /api, so the in-app login does NOT protect it. Set METRICS_TOKEN to require
# `Authorization: Bearer <token>` from the scraper; leave blank for open scraping on a trusted net.
METRICS_ENABLED=true
METRICS_TOKEN=

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8001

# --- Sample DBs (optional, only used with --profile samples) ---
SAMPLE_SOURCE_PASSWORD=samplesource
SAMPLE_DEST_PASSWORD=sampledest

# --- Optional engine test DBs (`make up-mysql` / `make up-mssql` / `make up-engines`) ---
# Host ports: MySQL 3307, SQL Server 14333. From the UI use compose hostnames + container ports.
ENGINE_MYSQL_PASSWORD=EngineMySQL_ChangeMe!
ENGINE_MYSQL_DATABASE=testdb
# Must meet SQL Server complexity (upper, lower, digit, symbol; length >= 8).
ENGINE_MSSQL_PASSWORD=EngineMSSQL_ChangeMe1!

# --- Licensing (offline Ed25519 keys; Stripe = vendor issuer only) ---
# Local docker: set true to unlock Pro (mysql/mssql + full Mel) without pasting a key.
# Never enable in production.
DATAMETL_LICENSE_DEV_BYPASS=false
# Optional override of the embedded verify public key (base64url 32-byte Ed25519).
LICENSE_PUBLIC_KEY=
# Issuer-only (scripts/issue_license.py / make license-issue). Never commit this value.
# LICENSE_SIGNING_KEY=

# --- Vendor Stripe issuer (Phase 2) — OPTIONAL; leave blank for Community / self-hosted ---
# When both STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET are set, POST /api/billing/stripe/webhook
# verifies Stripe-Signature and mints a Pro dmtl1 key (requires LICENSE_SIGNING_KEY).
# Never commit real secrets. Never put these in customer deploy compose by default.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=price_1UDWhFLRy9hgB11RWQ9Xp9FJ
# Optional JSON file for webhook idempotency (event id / session id). Default: in-memory.
# STRIPE_ISSUANCE_STORE_PATH=/data/stripe_issuance.json

# Optional SMTP for emailing minted keys (otherwise log-only / webhook JSON for test).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Public Payment Link for Settings → Buy Pro (frontend). Sandbox test link:
NEXT_PUBLIC_DATAMETL_PRO_URL=https://buy.stripe.com/test_6oU8wQ9cL1Bv3Av9cw7ok00
