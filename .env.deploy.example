# DataMETL deployment env (the install.sh script generates a .env from this and
# automatically fills ENCRYPTION_KEY + APP_DB_PASSWORD with fresh secrets).

# --- Required ---
# Fernet key used to encrypt user-supplied DB credentials at rest. Generate with:
#   openssl rand -base64 32 | tr "+/" "-_"
# install.sh does this for you on first run. Empty / CHANGE_ME values are refused at startup.
ENCRYPTION_KEY=

# --- Optional, with sensible defaults ---
# The release tag (or "latest") to pull from ghcr.io/sbcsp/*
DATAMETL_VERSION=latest

# Host port to expose the UI on. The backend / DB / Redis are NOT exposed by default —
# the frontend proxies API requests internally. 3005 avoids the most common collisions
# (3000 is the default for many dev tools). Change freely; only this port is exposed.
FRONTEND_PORT=3005

# Core app config (lives in .env, but user-facing and can be overridden at runtime with env vars).
CORS_ORIGINS=http://localhost:3005

# App metadata DB credentials (internal compose network only). install.sh replaces the
# default password with a strong random value on first run — do not ship weak defaults.
APP_DB_USER=datametl
APP_DB_PASSWORD=CHANGE_ME_INSTALL_WILL_REPLACE
APP_DB_NAME=datametl

# Logging
LOG_LEVEL=INFO

# --- Auth / exposure ---
# Production must sit behind SSO (oauth2-proxy / Keycloak / similar) OR enable in-app AUTH.
# Leaving AUTH_ENABLED=false with a publicly reachable UI is unsafe.
AUTH_ENABLED=false
AUTH_USERNAME=admin
AUTH_PASSWORD=
AUTH_TOKEN_TTL_HOURS=168

# Prometheus /metrics (outside /api). Set METRICS_TOKEN for bearer-protected scrapes.
METRICS_ENABLED=true
METRICS_TOKEN=

# OpenAPI UI (/docs, /redoc, /openapi.json). Off by default for deploy images.
DOCS_ENABLED=false
